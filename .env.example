# ---------- Database ----------
# Option A: a single connection string (Railway / hosted MySQL).
# DATABASE_URL=mysql://user:password@host:port/database
# MYSQL_URL is also accepted as an alias.
DATABASE_URL=

# Option B: individual settings (used when DATABASE_URL / MYSQL_URL is empty)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dalab_online

# ---------- Auth ----------
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---------- Server ----------
# PORT is set automatically by most hosts; defaults to 3001 locally.
PORT=
NODE_ENV=development

# ---------- AI (Google Gemini) — optional ----------
# Without a key the chatbot falls back to keyword search.
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# ---------- Image uploads (ImageKit) — optional ----------
# Without these, vendors paste image URLs instead of uploading files.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ---------- Email for contact forms (Nodemailer) — optional ----------
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
